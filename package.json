{
  "name": "worklens",
  "version": "0.1.4",
  "description": "Local-first daily work organizer and stand-up script generator",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "generate:icons:win": "node scripts/generate-windows-icon.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && npm run generate:icons:win && electron-builder --win nsis --x64 --publish never"
  },
  "keywords": [
    "electron",
    "local-first",
    "knowledge-management",
    "cursor-cli"
  ],
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "archiver": "^8.0.0",
    "date-fns": "^4.4.0",
    "file-type": "^22.0.2",
    "lucide-react": "^1.44.0",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
